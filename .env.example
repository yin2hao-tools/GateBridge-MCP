GATEBRIDGE_UPSTREAM_URL=ws://127.0.0.1:8777/ws
GATEBRIDGE_DEVICE_ID=mg946r-001
GATEBRIDGE_DEVICE_TOKEN=replace-with-existing-device-token
GATEBRIDGE_TIMEOUT=8
GATEBRIDGE_STATUS_MAX_AGE=30

# HTTP only. Use a different token from the upstream device token.
GATEBRIDGE_API_TOKEN=replace-with-a-long-random-client-token
GATEBRIDGE_ALLOWED_HOSTS=mcp.example.com
GATEBRIDGE_ALLOWED_ORIGINS=https://your-robot.example.com
